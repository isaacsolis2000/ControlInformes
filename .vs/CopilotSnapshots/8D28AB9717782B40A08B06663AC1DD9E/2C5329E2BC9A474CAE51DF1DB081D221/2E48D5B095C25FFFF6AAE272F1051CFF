using ControlInformes.Application.DTOs;
using ControlInformes.Domain.Enums;
using ControlInformes.Domain.Interfaces;
using MediatR;

namespace ControlInformes.Application.Features.Reportes.Queries;

public class ObtenerResumenMensualQueryHandler : IRequestHandler<ObtenerResumenMensualQuery, ResumenMensualDto>
{
    private readonly IUnitOfWork _unitOfWork;

    public ObtenerResumenMensualQueryHandler(IUnitOfWork unitOfWork)
    {
        _unitOfWork = unitOfWork;
    }

    public async Task<ResumenMensualDto> Handle(ObtenerResumenMensualQuery request, CancellationToken cancellationToken)
    {
        var publicadoresActivos = await _unitOfWork.Publicadores.FindAsync(p => p.Activo);
        var informes = await _unitOfWork.InformesMensuales.GetByMesAsync(request.Año, request.Mes);

        var primerDiaMes = new DateTime(request.Año, request.Mes, 1);
        var ultimoDiaMes = primerDiaMes.AddMonths(1).AddDays(-1);
        var asistencias = await _unitOfWork.Asistencias.GetByRangoAsync(primerDiaMes, ultimoDiaMes);

        var resumen = new ResumenMensualDto
        {
            Año = request.Año,
            Mes = request.Mes,
            TotalPublicadoresActivos = publicadoresActivos.Count,
            CantidadInformes = informes.Count,
            TotalCursosBiblicos = informes.Sum(i => i.CursosBiblicos),
            TotalHorasPrecursores = informes.Where(i => i.Horas.HasValue).Sum(i => i.Horas!.Value),
            PromedioAsistencia = asistencias.Count > 0 ? asistencias.Average(a => a.Cantidad) : 0
        };

        var infPublicadores = informes.Where(i => i.Tipo == TipoPublicador.Publicador || i.Tipo == TipoPublicador.NoBautizado).ToList();
        resumen.Publicadores = new ResumenGrupoDto
        {
            Total = publicadoresActivos.Count(p => p.Tipo == TipoPublicador.Publicador || p.Tipo == TipoPublicador.NoBautizado),
            Informaron = infPublicadores.Count,
            CursosBiblicos = infPublicadores.Sum(i => i.CursosBiblicos),
            Horas = 0
        };

        var infAuxiliares = informes.Where(i => i.Tipo == TipoPublicador.PrecursorAuxiliar).ToList();
        resumen.PrecursoresAuxiliares = new ResumenGrupoDto
        {
            Total = publicadoresActivos.Count(p => p.Tipo == TipoPublicador.PrecursorAuxiliar),
            Informaron = infAuxiliares.Count,
            CursosBiblicos = infAuxiliares.Sum(i => i.CursosBiblicos),
            Horas = infAuxiliares.Where(i => i.Horas.HasValue).Sum(i => i.Horas!.Value)
        };

        var infRegulares = informes.Where(i => i.Tipo == TipoPublicador.PrecursorRegular).ToList();
        resumen.PrecursoresRegulares = new ResumenGrupoDto
        {
            Total = publicadoresActivos.Count(p => p.Tipo == TipoPublicador.PrecursorRegular),
            Informaron = infRegulares.Count,
            CursosBiblicos = infRegulares.Sum(i => i.CursosBiblicos),
            Horas = infRegulares.Where(i => i.Horas.HasValue).Sum(i => i.Horas!.Value)
        };

        return resumen;
    }
}
