using ControlInformes.Application.Common.Exceptions;
using ControlInformes.Domain.Entities;
using ControlInformes.Domain.Enums;
using ControlInformes.Domain.Interfaces;
using MediatR;

namespace ControlInformes.Application.Features.Informes.Commands;

public class RegistrarInformeMensualCommandHandler : IRequestHandler<RegistrarInformeMensualCommand, Guid>
{
    private readonly IUnitOfWork _unitOfWork;

    public RegistrarInformeMensualCommandHandler(IUnitOfWork unitOfWork)
    {
        _unitOfWork = unitOfWork;
    }

    public async Task<Guid> Handle(RegistrarInformeMensualCommand request, CancellationToken cancellationToken)
    {
        var publicador = await _unitOfWork.Publicadores.GetByIdAsync(request.IdPublicador)
            ?? throw new NotFoundException(nameof(Publicador), request.IdPublicador);

        int? horas = (publicador.Tipo == TipoPublicador.PrecursorAuxiliar || publicador.Tipo == TipoPublicador.PrecursorRegular)
            ? request.Horas : null;

        var existente = await _unitOfWork.InformesMensuales.GetByPublicadorMesAsync(request.IdPublicador, request.Ano, request.Mes);

        if (existente != null)
        {
            existente.Participo = request.Participo;
            existente.CursosBiblicos = request.CursosBiblicos;
            existente.Horas = horas;
            existente.Tipo = publicador.Tipo;
            _unitOfWork.InformesMensuales.Update(existente);
            await _unitOfWork.SaveChangesAsync(cancellationToken);
            return existente.IdInformeMensual;
        }

        var informe = new InformeMensual
        {
            IdInformeMensual = Guid.NewGuid(),
            IdPublicador = request.IdPublicador,
            Ano = request.Ano,
            Mes = request.Mes,
            Participo = request.Participo,
            CursosBiblicos = request.CursosBiblicos,
            Horas = horas,
            Tipo = publicador.Tipo
        };

        await _unitOfWork.InformesMensuales.AddAsync(informe);
        await _unitOfWork.SaveChangesAsync(cancellationToken);

        return informe.IdInformeMensual;
    }
}
