namespace ControlInformes.Application.DTOs;

public class ResumenMensualDto
{
    public int Ano { get; set; }
    public int Mes { get; set; }
    public int TotalPublicadoresActivos { get; set; }
    public int CantidadInformes { get; set; }
    public int TotalCursosBiblicos { get; set; }
    public int TotalHorasPrecursores { get; set; }
    public double PromedioAsistencia { get; set; }

    public ResumenGrupoDto Publicadores { get; set; } = new();
    public ResumenGrupoDto PrecursoresAuxiliares { get; set; } = new();
    public ResumenGrupoDto PrecursoresRegulares { get; set; } = new();
}

public class ResumenGrupoDto
{
    public int Total { get; set; }
    public int Informaron { get; set; }
    public int CursosBiblicos { get; set; }
    public int Horas { get; set; }
