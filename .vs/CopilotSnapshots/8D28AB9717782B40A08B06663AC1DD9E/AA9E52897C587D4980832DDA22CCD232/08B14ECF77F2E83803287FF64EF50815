using ControlInformes.Application.Common;
using ControlInformes.Application.DTOs;
using ControlInformes.Application.Features.Asistencia.Commands;
using ControlInformes.Application.Features.Asistencia.Queries;
using MediatR;
using Microsoft.AspNetCore.Mvc;

namespace ControlInformes.API.Controllers;

[ApiController]
[Route("api/asistencia")]
public class AsistenciaController : ControllerBase
{
    private readonly IMediator _mediator;

    public AsistenciaController(IMediator mediator)
    {
        _mediator = mediator;
    }

    [HttpPost]
    public async Task<ActionResult<ApiResponse<Guid>>> Registrar([FromBody] RegistrarAsistenciaCommand command)
    {
        var id = await _mediator.Send(command);
        return Ok(ApiResponse<Guid>.Ok(id, "Asistencia registrada."));
    }

    [HttpGet]
    public async Task<ActionResult<ApiResponse<IReadOnlyList<AsistenciaDto>>>> GetByRango([FromQuery] DateTime fechaInicio, [FromQuery] DateTime fechaFin)
    {
        var result = await _mediator.Send(new ObtenerAsistenciaPorRangoQuery(fechaInicio, fechaFin));
        return Ok(ApiResponse<IReadOnlyList<AsistenciaDto>>.Ok(result));
    }
}
