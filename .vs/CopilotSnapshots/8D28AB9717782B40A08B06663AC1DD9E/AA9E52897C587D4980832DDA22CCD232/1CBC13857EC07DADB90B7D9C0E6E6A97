using ControlInformes.Application.Common;
using ControlInformes.Application.DTOs;
using ControlInformes.Application.Features.Informes.Commands;
using ControlInformes.Application.Features.Informes.Queries;
using MediatR;
using Microsoft.AspNetCore.Mvc;

namespace ControlInformes.API.Controllers;

[ApiController]
[Route("api/informes")]
public class InformesController : ControllerBase
{
    private readonly IMediator _mediator;

    public InformesController(IMediator mediator)
    {
        _mediator = mediator;
    }

    [HttpPost]
    public async Task<ActionResult<ApiResponse<Guid>>> Registrar([FromBody] RegistrarInformeMensualCommand command)
    {
        var id = await _mediator.Send(command);
        return Ok(ApiResponse<Guid>.Ok(id, "Informe registrado."));
    }

    [HttpGet]
    public async Task<ActionResult<ApiResponse<IReadOnlyList<InformeMensualDto>>>> GetByMes([FromQuery] int ano, [FromQuery] int mes)
    {
        var result = await _mediator.Send(new ObtenerInformesPorMesQuery(ano, mes));
        return Ok(ApiResponse<IReadOnlyList<InformeMensualDto>>.Ok(result));
    }
}
